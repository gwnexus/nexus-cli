#!/usr/bin/env bash
# .githooks/pre-commit — nexus-cli
#
# 1. Gitleaks secret scan (staged changes) — fails closed.
# 2. cargo fmt --check + cargo clippy on staged Rust files.
#
# Wired automatically on 'devbox shell' via scripts/devbox/dbx_init.sh
# (git config core.hooksPath .githooks). Manual setup, if needed:
#   git config core.hooksPath .githooks

set -euo pipefail

# --- 1. Gitleaks -----------------------------------------------------------
if ! command -v gitleaks &>/dev/null; then
  echo "[pre-commit] ERROR: gitleaks not found. Install via: devbox shell (or brew install gitleaks)"
  echo "             Commits are blocked until gitleaks is available."
  echo "             To bypass (use with caution): git commit --no-verify"
  exit 1
fi

echo "[pre-commit] Running gitleaks on staged changes..."
GITLEAKS_EXIT=0
gitleaks protect --staged --config=.gitleaks.toml --no-banner || GITLEAKS_EXIT=$?

if [ "$GITLEAKS_EXIT" -eq 0 ]; then
  echo "[pre-commit] No secrets detected."
elif [ "$GITLEAKS_EXIT" -eq 1 ]; then
  echo ""
  echo "!! Gitleaks detected secrets in staged changes."
  echo "   Review the findings above and remove any credentials."
  echo "   To bypass (use with caution): git commit --no-verify"
  exit 1
else
  echo ""
  echo "!! Gitleaks exited with unexpected code $GITLEAKS_EXIT (scanner error)."
  echo "   Fix the scanner issue or bypass with: git commit --no-verify"
  exit 1
fi

# --- 2. Rust fmt + clippy (only if Rust files are staged) ------------------
RUST_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$RUST_STAGED" ]; then
  exit 0
fi

echo ">> Running cargo fmt --check..."

if ! RUSTFLAGS="" cargo fmt --all -- --check 2>/dev/null; then
  echo ""
  echo "!! Formatting check failed. Run 'cargo fmt --all' and stage the changes."
  echo ""
  exit 1
fi

echo "   Format check passed."

echo ">> Running cargo clippy..."

if ! RUSTFLAGS="" cargo clippy --workspace --all-targets -- -D warnings 2>&1; then
  echo ""
  echo "!! Clippy check failed. Fix the warnings above and stage the changes."
  echo ""
  exit 1
fi

echo "   Clippy check passed."
